        "design-screen",
        "design-to-code"
      ]
    },
    "data": {
      "name": "Base de datos",
      "description": "Esquema DBML, diagrama ER, Firebase / Supabase / Postgres + Prisma con entornos",
      "skills": [
        "schema",
        "er",
        "database"
      ]
    },
    "shared": {
      "name": "Textos y analítica",
      "description": "i18n y plan de analítica compartidos entre stacks, refactor entre plataformas",
      "skills": [
        "i18n",
        "analytics",
        "refactor-global"
      ]
    },
    "security": {
      "name": "Seguridad",
      "description": "Auditoría global, web y móvil con escáner",
      "skills": [
        "security-global",
        {
          "skill": "security-web",
          "when": "web"
        },
        {
          "skill": "security-mobile",
          "when": "mobile"
        }
      ]
    },
    "release": {
      "name": "Release y marketing",
      "description": "Cerrar versiones, notas de tienda, capturas para tiendas, campañas e ideas de crecimiento",
      "skills": [
        "release",
        "marketing",
        "screenshots"
      ]
    },
    "convert": {
      "name": "Conversor",
      "description": "Convertir entre stacks (web ⇄ móvil y migraciones)",
      "skills": [
        "convert"
      ]
    }
  },
  "agents": {
    "claude": {
      "name": "Claude Code",
      "how": "plugin local con hooks (comandos /dualcraft:*)"
    },
    "gemini": {
      "name": "Gemini CLI",
      "how": "skills en ~/.gemini/skills + bloque en ~/.gemini/GEMINI.md"
    },
    "codex": {
      "name": "Codex CLI",
      "how": "skills en ~/.codex/skills + bloque en ~/.codex/AGENTS.md"
    }
  }
