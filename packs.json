{
  "$comment": "DualCraft packs for the installer (bin/dualcraft.mjs). 'core' is always installed. A stack pack adds its reference sheet and pulls in its platform pack (web-platform or mobile-platform). Optional packs add their skills; 'when' limits a skill to projects with that kind of stack.",
  "core": {
    "name": "Núcleo",
    "description": "Brain, decisiones, modos de trabajo, proceso (brainstorm, plan, TDD, debug, verify, review), documento funcional, commits",
    "skills": [
      "using-dualcraft",
      "help",
      "new-project",
      "stacks",
      "start",
      "commit",
      "brain",
      "decisions",
      "park",
      "map",
      "roadmap",
      "brainstorm",
      "plan",
      "tdd",
      "debug",
      "verify",
      "review",
      "docs",
      "github",
      "share"
    ]
  },
  "platforms": {
    "web-platform": {
      "name": "Web (común)",
      "skills": [
        "web-architecture",
        "web-build",
        "web-test",
        "web-browser",
        "web-seo",
        "refactor-web"
      ]
    },
    "mobile-platform": {
      "name": "Móvil (común)",
      "skills": [
        "mobile-architecture",
        "mobile-build",
        "mobile-test",
        "mobile-device",
        "mobile-crash",
        "refactor-mobile"
      ]
    }
  },
  "stacks": {
    "nextjs": {
      "name": "Next.js",
      "kind": "web"
    },
    "react-vite": {
      "name": "React + Vite",
      "kind": "web"
    },
    "astro": {
      "name": "Astro",
      "kind": "web"
    },
    "nuxt": {
      "name": "Vue / Nuxt",
      "kind": "web"
    },
    "flutter": {
      "name": "Flutter",
      "kind": "mobile"
    },
    "react-native": {
      "name": "React Native (Expo)",
      "kind": "mobile"
    },
    "kmp": {
      "name": "Kotlin Multiplatform",
      "kind": "mobile"
    },
    "android": {
      "name": "Android nativo (Compose)",
      "kind": "mobile"
    },
    "ios": {
      "name": "iOS nativo (SwiftUI)",
      "kind": "mobile"
    }
  },
  "optional": {
    "design": {
      "name": "Diseño",
      "description": "Design System de claude.ai, tokens, pantallas y diseño → código",
      "skills": [
        "design-system",
