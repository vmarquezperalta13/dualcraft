{
  "$comment": "DualCraft stack registry. Each stack has a reference file stacks/<id>.md read by the web-*/mobile-* skills. 'generators' lists the DualCraft generators that support it (tokens, i18n, schema, analytics).",
  "stacks": [
    { "id": "nextjs", "kind": "web", "name": "Next.js", "language": "TypeScript", "pack": "web-nextjs",
      "detect": { "file": "package.json", "dependency": "next" },
      "scaffold": "npx create-next-app@latest {dir} --ts --tailwind --app --src-dir --eslint --use-npm",
      "generators": ["tokens", "i18n", "schema", "analytics"] },
    { "id": "react-vite", "kind": "web", "name": "React + Vite", "language": "TypeScript", "pack": "web-react",
      "detect": { "file": "package.json", "dependency": "vite", "and": "react", "not": ["next", "astro", "nuxt", "expo"] },
      "scaffold": "npm create vite@latest {dir} -- --template react-ts",
      "generators": ["tokens", "i18n", "schema", "analytics"] },
    { "id": "astro", "kind": "web", "name": "Astro", "language": "TypeScript", "pack": "web-astro",
      "detect": { "file": "package.json", "dependency": "astro" },
      "scaffold": "npm create astro@latest {dir} -- --template minimal --install --no-git",
      "generators": ["tokens", "i18n", "schema", "analytics"] },
    { "id": "nuxt", "kind": "web", "name": "Vue / Nuxt", "language": "TypeScript", "pack": "web-nuxt",
      "detect": { "file": "package.json", "dependency": "nuxt" },
      "scaffold": "npm create nuxt@latest {dir}",
      "generators": ["tokens", "i18n", "schema", "analytics"] },
    { "id": "flutter", "kind": "mobile", "name": "Flutter", "language": "Dart", "pack": "mobile-flutter",
      "detect": { "file": "pubspec.yaml", "contains": "sdk: flutter" },
      "scaffold": "flutter create --org {org} --platforms android,ios {dir}",
      "generators": ["tokens", "i18n", "schema", "analytics"] },
    { "id": "react-native", "kind": "mobile", "name": "React Native (Expo)", "language": "TypeScript", "pack": "mobile-react-native",
      "detect": { "file": "package.json", "dependency": "react-native" },
      "scaffold": "npx create-expo-app@latest {dir} --template default",
      "generators": ["tokens", "i18n", "schema", "analytics"] },
    { "id": "kmp", "kind": "mobile", "name": "Kotlin Multiplatform (Compose Multiplatform)", "language": "Kotlin", "pack": "mobile-kmp",
      "detect": { "glob": "**/src/commonMain", "or": { "file": "build.gradle.kts", "contains": "kotlin(\"multiplatform\")|kotlinMultiplatform" } },
      "scaffold": "JetBrains KMP wizard (https://kmp.jetbrains.com) → download, unzip into {dir}; or git clone https://github.com/Kotlin/KMP-App-Template {dir}",
      "generators": ["tokens", "i18n", "schema", "analytics"] },
    { "id": "android", "kind": "mobile", "name": "Android nativo (Kotlin + Jetpack Compose)", "language": "Kotlin", "pack": "mobile-android",
      "detect": { "file": "app/build.gradle.kts|app/build.gradle", "contains": "com.android.application", "not": ["kotlinMultiplatform", "flutter"] },
      "scaffold": "Android Studio → New Project → Empty Activity (Compose) in {dir} (no official CLI generator)",
      "generators": ["tokens", "i18n", "schema", "analytics"] },
    { "id": "ios", "kind": "mobile", "name": "iOS nativo (Swift + SwiftUI)", "language": "Swift", "pack": "mobile-ios",
      "detect": { "glob": "*.xcodeproj|project.yml|Package.swift", "not": ["pubspec.yaml", "package.json"] },
      "scaffold": "macOS only: Xcode → New Project → App (SwiftUI), or XcodeGen with a project.yml in {dir}",
      "generators": ["tokens", "i18n", "schema", "analytics"] }
  ],
  "backends": [
    { "id": "firebase", "name": "Firebase (Firestore, Auth, Storage, Functions)", "cli": "firebase", "install": "npm i -g firebase-tools", "local": "firebase emulators:start" },
    { "id": "supabase", "name": "Supabase (Postgres, Auth, Storage, Edge Functions)", "cli": "supabase", "install": "npx supabase (or scoop/brew install supabase)", "local": "supabase start (Docker)" },
    { "id": "postgres-prisma", "name": "PostgreSQL + Prisma", "cli": "prisma", "install": "npm i -D prisma && npm i @prisma/client", "local": "docker run postgres / docker compose" }
  ]
}
