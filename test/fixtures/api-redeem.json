{
  "description": "Canjea un código promocional",
  "input": {
    "code": { "type": "string", "required": true, "pattern": "^[A-Z0-9_-]{3,32}$" },
    "platform": { "type": "string", "values": ["android", "ios", "web"] },
    "tags": { "type": "string", "array": true, "maxItems": 5, "maxLength": 20 },
    "class": { "type": "int", "min": 0 },
    "meta": { "type": "json" }
  },
  "output": {
    "coins": { "type": "int", "required": true },
    "ratio": { "type": "double" },
    "level": { "type": "string", "values": ["gold", "silver-plus"], "required": true },
    "extra": { "type": "json" },
    "items": { "type": "string", "array": true },
    "levels": { "type": "string", "values": ["gold", "silver-plus"], "array": true },
    "default": { "type": "bool" }
  },
  "errors": ["not-found", "already-exists"]
}
